<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE martif PUBLIC "ISO 12200:1999A//DTD MARTIF core (DXFcdV04)//EN" "TBXcdv04.dtd">
<martif type="TBX" xml:lang="ja">
  <martifHeader>
    <fileDesc>
      <sourceDesc>
        <p>Translate Toolkit</p>
      </sourceDesc>
    </fileDesc>
  </martifHeader>
  <text>
    <body>
      <termEntry id="term_aa">
        <langSet xml:lang="ja"><tig><term>ああ</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>aah</term></tig></langSet>
        <descrip>Interjección que expresa comprensión, sorpresa o suspiro.</descrip>
      </termEntry>
      <termEntry id="term_aamaa">
        <langSet xml:lang="ja"><tig><term>アーマー</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>armadura</term></tig></langSet>
        <descrip>Término en katakana para 'armor' (armadura).</descrip>
      </termEntry>
      <termEntry id="term_aero">
        <langSet xml:lang="ja"><tig><term>アエロー</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>aerohierba</term></tig></langSet>
        <descrip>Nombre de un tipo de hierba, probablemente mágica.</descrip>
      </termEntry>
      <termEntry id="term_ai">
        <langSet xml:lang="ja"><tig><term>愛</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>amor</term></tig></langSet>
        <descrip>Sustantivo para 'amor'.</descrip>
      </termEntry>
      <termEntry id="term_ajin">
        <langSet xml:lang="ja"><tig><term>亜人</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>semihumano</term></tig></langSet>
        <descrip>Raza que no es completamente humana, como elfos, enanos, etc. Literalmente 'sub-humano'.</descrip>
      </termEntry>
      <termEntry id="term_ane">
        <langSet xml:lang="ja"><tig><term>姉</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>hermana mayor</term></tig></langSet>
        <descrip>Término para referirse a la hermana mayor de uno.</descrip>
      </termEntry>
      <termEntry id="term_ani">
        <langSet xml:lang="ja"><tig><term>兄</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>hermano mayor</term></tig></langSet>
        <descrip>Término para referirse al hermano mayor de uno.</descrip>
      </termEntry>
      <termEntry id="term_anime">
        <langSet xml:lang="ja"><tig><term>アニメ</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>anime</term></tig></langSet>
        <descrip>Animación japonesa.</descrip>
      </termEntry>
      <termEntry id="term_are">
        <langSet xml:lang="ja"><tig><term>あれ</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>eso de ahí</term></tig></langSet>
        <descrip>Pronombre demostrativo para algo lejano tanto del hablante como del oyente.</descrip>
      </termEntry>
      <termEntry id="term_arigatou">
        <langSet xml:lang="ja"><tig><term>ありがとう</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>gracias</term></tig></langSet>
        <descrip>Forma común de decir 'gracias'.</descrip>
      </termEntry>
      <termEntry id="term_bibou">
        <langSet xml:lang="ja"><tig><term>美貌</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>belleza</term></tig></langSet>
        <descrip>Belleza facial o apariencia atractiva.</descrip>
      </termEntry>
      <termEntry id="term_bishoujo">
        <langSet xml:lang="ja"><tig><term>美少女</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>niña hermosa</term></tig></langSet>
        <descrip>Término para una chica joven y hermosa.</descrip>
        <note from="translator">A veces se traduce como 'mujer hermosa' dependiendo de la edad.</note>
      </termEntry>
      <termEntry id="term_boukensha">
        <langSet xml:lang="ja"><tig><term>冒険者</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>aventurero</term></tig></langSet>
        <descrip>Persona que se dedica a la aventura, común en géneros de fantasía.</descrip>
      </termEntry>
      <termEntry id="term_buraddokuriinkooteingu">
        <langSet xml:lang="ja"><tig><term>ブラッドクリーンコーティング</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>revestimiento removedor de sangre</term></tig></langSet>
        <descrip>Del inglés 'Blood Clean Coating'. Un encantamiento o característica de un equipo.</descrip>
      </termEntry>
      <termEntry id="term_burakkuuuzu">
        <langSet xml:lang="ja"><tig><term>ブラックウーズ</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>limo oscuro</term></tig></langSet>
        <descrip>Del inglés 'Black Ooze'. Un tipo de monstruo de fantasía.</descrip>
        <note from="translator">Alternativa: black ooze.</note>
      </termEntry>
      <termEntry id="term_chishiki">
        <langSet xml:lang="ja"><tig><term>知識</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>conocimiento</term></tig></langSet>
        <descrip>Sustantivo para 'conocimiento' o 'sabiduría'.</descrip>
      </termEntry>
      <termEntry id="term_chiryouyaku">
        <langSet xml:lang="ja"><tig><term>治療薬</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>poción de recuperación</term></tig></langSet>
        <descrip>Medicina o poción para curar heridas o enfermedades.</descrip>
      </termEntry>
      <termEntry id="term_daiisshou">
        <langSet xml:lang="ja"><tig><term>第一章</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>episodio 1</term></tig></langSet>
        <descrip>Primer capítulo o episodio de una obra.</descrip>
        <note from="translator">Alternativa: capítulo 1.</note>
      </termEntry>
      <termEntry id="term_denshou">
        <langSet xml:lang="ja"><tig><term>伝承</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>efectivamente</term></tig></langSet>
        <descrip>Tradición, leyenda o folclore.</descrip>
      </termEntry>
      <termEntry id="term_doukutsu">
        <langSet xml:lang="ja"><tig><term>洞窟</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>cueva</term></tig></langSet>
        <descrip>Una cueva o caverna.</descrip>
      </termEntry>
      <termEntry id="term_dorei_no_seigen">
        <langSet xml:lang="ja"><tig><term>奴隷の制限</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>restricción de esclavos</term></tig></langSet>
        <descrip>Una habilidad o regla que afecta a los esclavos.</descrip>
      </termEntry>
      <termEntry id="term_e">
        <langSet xml:lang="ja"><tig><term>え</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>¿eh?</term></tig></langSet>
        <descrip>Interjección de sorpresa o duda.</descrip>
      </termEntry>
      <termEntry id="term_ei">
        <langSet xml:lang="ja"><tig><term>えい</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>¡ei!</term></tig></langSet>
        <descrip>Exclamación o grito al realizar un esfuerzo.</descrip>
        <note from="translator">Grito de esfuerzo.</note>
      </termEntry>
      <termEntry id="term_eiyouzai">
        <langSet xml:lang="ja"><tig><term>栄養剤</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>suplemento nutricional</term></tig></langSet>
        <descrip>Un suplemento que provee nutrientes.</descrip>
      </termEntry>
      <termEntry id="term_erufu">
        <langSet xml:lang="ja"><tig><term>エルフ</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>elfo</term></tig></langSet>
        <descrip>Raza de fantasía 'elfo'.</descrip>
      </termEntry>
      <termEntry id="term_etto">
        <langSet xml:lang="ja"><tig><term>えっと</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>emm</term></tig></langSet>
        <descrip>Interjección usada para pensar o dudar antes de hablar.</descrip>
      </termEntry>
      <termEntry id="term_eushuare">
        <langSet xml:lang="ja"><tig><term>エウシュアレ</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>eushuale</term></tig></langSet>
        <descrip>Nombre de la diosa y del mundo.</descrip>
      </termEntry>
      <termEntry id="term_fontiiru">
        <langSet xml:lang="ja"><tig><term>フォンティーユ</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>fontille</term></tig></langSet>
        <descrip>Nombre de un país.</descrip>
      </termEntry>
      <termEntry id="term_furei">
        <langSet xml:lang="ja"><tig><term>フレイ</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>frey</term></tig></langSet>
        <descrip>Nombre de la cazadora compañera del héroe.</descrip>
      </termEntry>
      <termEntry id="term_fumu">
        <langSet xml:lang="ja"><tig><term>ふむ</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>ujum</term></tig></langSet>
        <descrip>Sonido de asentimiento o reflexión.</descrip>
        <note from="translator">Sonido al asentir o pensar.</note>
      </termEntry>
      <termEntry id="term_gakuin">
        <langSet xml:lang="ja"><tig><term>学院</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>academia</term></tig></langSet>
        <descrip>Institución educativa, generalmente de nivel superior o especializado.</descrip>
        <note from="translator">A veces se puede traducir como escuela.</note>
      </termEntry>
      <termEntry id="term_gakugyou">
        <langSet xml:lang="ja"><tig><term>学業</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>clases</term></tig></langSet>
        <descrip>Estudios o deberes escolares.</descrip>
      </termEntry>
      <termEntry id="term_geemu">
        <langSet xml:lang="ja"><tig><term>ゲーム</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>juego</term></tig></langSet>
        <descrip>Del inglés 'game'. Se refiere a videojuegos.</descrip>
      </termEntry>
      <termEntry id="term_gimpatsu">
        <langSet xml:lang="ja"><tig><term>銀髪</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>cabello plateado</term></tig></langSet>
        <descrip>Cabello de color plata.</descrip>
      </termEntry>
      <termEntry id="term_goburin">
        <langSet xml:lang="ja"><tig><term>ゴブリン</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>duende</term></tig></langSet>
        <descrip>Raza de monstruo de fantasía 'goblin'.</descrip>
        <note from="translator">También se usa "goblin" directamente.</note>
      </termEntry>
      <termEntry id="term_haa">
        <langSet xml:lang="ja"><tig><term>はぁ</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>jah</term></tig></langSet>
        <descrip>Onomatopeya de un suspiro de cansancio, alivio o exasperación.</descrip>
        <note from="translator">Suspiro.</note>
      </termEntry>
      <termEntry id="term_haha">
        <langSet xml:lang="ja"><tig><term>母</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>madre</term></tig></langSet>
        <descrip>Forma común para referirse a la propia madre.</descrip>
      </termEntry>
      <termEntry id="term_hai">
        <langSet xml:lang="ja"><tig><term>はい</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>sí</term></tig></langSet>
        <descrip>Forma estándar y cortés de decir 'sí'.</descrip>
      </termEntry>
      <termEntry id="term_hanashi">
        <langSet xml:lang="ja"><tig><term>話</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>conversación</term></tig></langSet>
        <descrip>Sustantivo para 'charla', 'historia' o 'tema'.</descrip>
        <note from="translator">También puede ser 'historia' o 'tema'. Como verbo (話す): hablar.</note>
      </termEntry>
      <termEntry id="term_hee">
        <langSet xml:lang="ja"><tig><term>へー</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>em...</term></tig></langSet>
        <descrip>Interjección que expresa sorpresa o interés.</descrip>
      </termEntry>
      <termEntry id="term_heion">
        <langSet xml:lang="ja"><tig><term>平穏</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>pacífico</term></tig></langSet>
        <descrip>Adjetivo que significa calma, tranquilidad o paz.</descrip>
      </termEntry>
      <termEntry id="term_heiwa">
        <langSet xml:lang="ja"><tig><term>平和</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>paz</term></tig></langSet>
        <descrip>Sustantivo que significa 'paz'.</descrip>
      </termEntry>
      <termEntry id="term_hiiru_ganyaku">
        <langSet xml:lang="ja"><tig><term>ヒール丸薬</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>píldora sanadora</term></tig></langSet>
        <descrip>Del inglés 'Heal Pill'. Objeto curativo.</descrip>
      </termEntry>
      <termEntry id="term_hinshitsu">
        <langSet xml:lang="ja"><tig><term>品質</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>calidad</term></tig></langSet>
        <descrip>Sustantivo para 'calidad' de un producto.</descrip>
      </termEntry>
      <termEntry id="term_hitomi">
        <langSet xml:lang="ja"><tig><term>瞳</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>ojos</term></tig></langSet>
        <descrip>Término poético para 'pupila' u 'ojos'.</descrip>
      </termEntry>
      <termEntry id="term_hontou_wa">
        <langSet xml:lang="ja"><tig><term>本当は</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>honestamente</term></tig></langSet>
        <descrip>Expresión que significa 'en realidad', 'la verdad es'.</descrip>
      </termEntry>
      <termEntry id="term_hou">
        <langSet xml:lang="ja"><tig><term>ほう</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>wow</term></tig></langSet>
        <descrip>Interjección que denota impresión o interés.</descrip>
      </termEntry>
      <termEntry id="term_ibento">
        <langSet xml:lang="ja"><tig><term>イベント</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>evento</term></tig></langSet>
        <descrip>Del inglés 'event'. Un suceso o acontecimiento.</descrip>
      </termEntry>
      <termEntry id="term_ie">
        <langSet xml:lang="ja"><tig><term>家</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>casa</term></tig></langSet>
        <descrip>Sustantivo para 'casa' u 'hogar'.</descrip>
        <note from="translator">También 'hogar'.</note>
      </termEntry>
      <termEntry id="term_imouto">
        <langSet xml:lang="ja"><tig><term>妹</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>hermana menor</term></tig></langSet>
        <descrip>Término para referirse a la hermana menor de uno.</descrip>
      </termEntry>
      <termEntry id="term_isekai">
        <langSet xml:lang="ja"><tig><term>異世界</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>otro mundo</term></tig></langSet>
        <descrip>Género y concepto de un mundo diferente al nuestro, común en anime y novelas ligeras.</descrip>
      </termEntry>
      <termEntry id="term_iya">
        <langSet xml:lang="ja"><tig><term>いや</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>no</term></tig></langSet>
        <descrip>Interjección informal para negar algo o expresar desacuerdo.</descrip>
      </termEntry>
      <termEntry id="term_jaana">
        <langSet xml:lang="ja"><tig><term>じゃあな</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>nos vemos</term></tig></langSet>
        <descrip>Forma informal de despedida, similar a 'hasta luego'.</descrip>
      </termEntry>
      <termEntry id="term_jijuu">
        <langSet xml:lang="ja"><tig><term>侍従</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>sirviente</term></tig></langSet>
        <descrip>Un chambelán, asistente o sirviente de alto rango.</descrip>
      </termEntry>
      <termEntry id="term_jikan">
        <langSet xml:lang="ja"><tig><term>時間</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>tiempo</term></tig></langSet>
        <descrip>Sustantivo para 'tiempo' u 'hora'.</descrip>
        <note from="translator">También se puede referir a 'hora'.</note>
      </termEntry>
      <termEntry id="term_josei">
        <langSet xml:lang="ja"><tig><term>女性</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>femenina</term></tig></langSet>
        <descrip>Término formal para 'mujer' o 'femenino'.</descrip>
      </termEntry>
      <termEntry id="term_jou備薬">
        <langSet xml:lang="ja"><tig><term>常備薬</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>medicamento regular</term></tig></langSet>
        <descrip>Medicina que se tiene a mano para uso doméstico o regular.</descrip>
      </termEntry>
      <termEntry id="term_joou">
        <langSet xml:lang="ja"><tig><term>女王</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>reina</term></tig></langSet>
        <descrip>Sustantivo para 'reina'.</descrip>
      </termEntry>
      <termEntry id="term_juujin">
        <langSet xml:lang="ja"><tig><term>獣人</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>hombres bestia</term></tig></langSet>
        <descrip>Raza de seres humanoides con rasgos animales.</descrip>
      </termEntry>
      <termEntry id="term_juusuunen">
        <langSet xml:lang="ja"><tig><term>十数年</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>más de diez años</term></tig></langSet>
        <descrip>Un período de tiempo de diez y algunos años, una década y pico.</descrip>
        <note from="translator">Literalmente: diez y varios años.</note>
      </termEntry>
      <termEntry id="term_jumon">
        <langSet xml:lang="ja"><tig><term>呪文</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>encantamiento</term></tig></langSet>
        <descrip>Un hechizo, conjuro o encantamiento mágico.</descrip>
      </termEntry>
      <termEntry id="term_kami">
        <langSet xml:lang="ja"><tig><term>髪</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>cabello</term></tig></langSet>
        <descrip>Sustantivo para 'cabello' o 'pelo'.</descrip>
      </termEntry>
      <termEntry id="term_kao">
        <langSet xml:lang="ja"><tig><term>顔</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>rostro</term></tig></langSet>
        <descrip>Sustantivo para 'cara' o 'rostro'.</descrip>
        <note from="translator">También: cara.</note>
      </termEntry>
      <termEntry id="term_kariudo">
        <langSet xml:lang="ja"><tig><term>狩人</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>cazadora</term></tig></langSet>
        <descrip>Un cazador o cazadora.</descrip>
      </termEntry>
      <termEntry id="term_kauntaa">
        <langSet xml:lang="ja"><tig><term>カウンター</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>mostrador</term></tig></langSet>
        <descrip>Del inglés 'counter'. Un mostrador de una tienda o bar.</descrip>
      </termEntry>
      <termEntry id="term_kedo">
        <langSet xml:lang="ja"><tig><term>けど</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>pero</term></tig></langSet>
        <descrip>Conjunción informal que significa 'pero' o 'sin embargo'.</descrip>
      </termEntry>
      <termEntry id="term_ken">
        <langSet xml:lang="ja"><tig><term>剣</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>espada</term></tig></langSet>
        <descrip>Sustantivo para 'espada'.</descrip>
      </termEntry>
      <termEntry id="term_kiri">
        <langSet xml:lang="ja"><tig><term>䨐</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>niebla</term></tig></langSet>
        <descrip>Sustantivo para 'niebla'.</descrip>
      </termEntry>
      <termEntry id="term_kishi">
        <langSet xml:lang="ja"><tig><term>騎士</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>caballero</term></tig></langSet>
        <descrip>Un caballero, guerrero noble.</descrip>
      </termEntry>
      <termEntry id="term_koe">
        <langSet xml:lang="ja"><tig><term>声</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>voz</term></tig></langSet>
        <descrip>Sustantivo para 'voz'.</descrip>
      </termEntry>
      <termEntry id="term_kokkaku_mushi">
        <langSet xml:lang="ja"><tig><term>甲殻虫</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>insecto</term></tig></langSet>
        <descrip>Un tipo de insecto con caparazón o exoesqueleto duro.</descrip>
      </termEntry>
      <termEntry id="term_kokoro">
        <langSet xml:lang="ja"><tig><term>心</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>corazón</term></tig></langSet>
        <descrip>En sentido figurado (mente, espíritu).</descrip>
      </termEntry>
      <termEntry id="term_kono">
        <langSet xml:lang="ja"><tig><term>この</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>este/esta</term></tig></langSet>
        <descrip>Adjetivo demostrativo para algo cercano al hablante.</descrip>
      </termEntry>
      <termEntry id="term_koumori">
        <langSet xml:lang="ja"><tig><term>蝙蝠</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>murciélago</term></tig></langSet>
        <descrip>Animal mamífero volador.</descrip>
      </termEntry>
      <termEntry id="term_kuni">
        <langSet xml:lang="ja"><tig><term>国</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>país</term></tig></langSet>
        <descrip>Sustantivo para 'país', 'nación' o 'reino'.</descrip>
        <note from="translator">También puede ser 'reino'.</note>
      </termEntry>
      <termEntry id="term_kurokami">
        <langSet xml:lang="ja"><tig><term>黒髪</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>cabello negro</term></tig></langSet>
        <descrip>Cabello de color negro.</descrip>
      </termEntry>
      <termEntry id="term_kusarikatabira">
        <langSet xml:lang="ja"><tig><term>くさりかたびら</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>cota de malla</term></tig></langSet>
        <descrip>Tipo de armadura hecha de anillos de metal entrelazados.</descrip>
      </termEntry>
      <termEntry id="term_ma">
        <langSet xml:lang="ja"><tig><term>間</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>habitación</term></tig></langSet>
        <descrip>Espacio, intervalo o habitación.</descrip>
      </termEntry>
      <termEntry id="term_maa">
        <langSet xml:lang="ja"><tig><term>まあ</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>bueno</term></tig></langSet>
        <descrip>Interjección que se usa para suavizar una declaración, similar a 'bueno...'.</descrip>
      </termEntry>
      <termEntry id="term_madou_joou">
        <langSet xml:lang="ja"><tig><term>魔導女王</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>reina mágica</term></tig></langSet>
        <descrip>Una reina que es poderosa en magia.</descrip>
      </termEntry>
      <termEntry id="term_madoushi">
        <langSet xml:lang="ja"><tig><term>魔導師</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>maga</term></tig></langSet>
        <descrip>Un hechicero o mago, practicante de magia. El género cambia según el contexto (mago/maga).</descrip>
      </termEntry>
      <termEntry id="term_mahi_doku">
        <langSet xml:lang="ja"><tig><term>麻痺毒</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>veneno paralizante</term></tig></langSet>
        <descrip>Un veneno que causa parálisis.</descrip>
      </termEntry>
      <termEntry id="term_mahou">
        <langSet xml:lang="ja"><tig><term>魔法</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>magia</term></tig></langSet>
        <descrip>Sustantivo para 'magia', 'hechicería'.</descrip>
      </termEntry>
      <termEntry id="term_mahoutsukai">
        <langSet xml:lang="ja"><tig><term>魔法使い</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>maga</term></tig></langSet>
        <descrip>Persona que usa magia.</descrip>
        <note from="translator">También: mago, hechicero, brujo.</note>
      </termEntry>
      <termEntry id="term_mamono">
        <langSet xml:lang="ja"><tig><term>魔物</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>monstruo</term></tig></langSet>
        <descrip>Literalmente: cosa demoníaca. Se refiere a monstruos o criaturas mágicas malignas.</descrip>
        <note from="translator">A veces traducido como "demonio" según el contexto.</note>
      </termEntry>
      <termEntry id="term_maou">
        <langSet xml:lang="ja"><tig><term>魔王</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>rey demonio</term></tig></langSet>
        <descrip>El señor o rey de los demonios, antagonista principal en muchas historias de fantasía.</descrip>
      </termEntry>
      <termEntry id="term_maria">
        <langSet xml:lang="ja"><tig><term>マリア</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>maría</term></tig></langSet>
        <descrip>Nombre propio femenino 'María'.</descrip>
      </termEntry>
      <termEntry id="term_mariaberu">
        <langSet xml:lang="ja"><tig><term>マリアベル</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>mariabelle</term></tig></langSet>
        <descrip>Nombre propio femenino 'Mariabelle'.</descrip>
      </termEntry>
      <termEntry id="term_mazoku">
        <langSet xml:lang="ja"><tig><term>魔族</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>demonio</term></tig></langSet>
        <descrip>Tribu o raza de demonios (demonkind).</descrip>
        <note from="translator">En la traducción provista, se traduce a veces igual que 魔物.</note>
      </termEntry>
      <termEntry id="term_megami">
        <langSet xml:lang="ja"><tig><term>女神</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>diosa</term></tig></langSet>
        <descrip>Deidad femenina.</descrip>
      </termEntry>
      <termEntry id="term_merutia">
        <langSet xml:lang="ja"><tig><term>メルティア</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>meltia</term></tig></langSet>
        <descrip>Nombre propio femenino 'Meltia'.</descrip>
      </termEntry>
      <termEntry id="term_mesu">
        <langSet xml:lang="ja"><tig><term>雌</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>hembra</term></tig></langSet>
        <descrip>Sexo femenino de un animal.</descrip>
      </termEntry>
      <termEntry id="term_misuriru">
        <langSet xml:lang="ja"><tig><term>ミスリル</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>mithril</term></tig></langSet>
        <descrip>Metal ficticio de gran valor y resistencia, común en la fantasía.</descrip>
        <note from="translator">Alternativa en el texto: plata mágica.</note>
      </termEntry>
      <termEntry id="term_mori">
        <langSet xml:lang="ja"><tig><term>森</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>bosque</term></tig></langSet>
        <descrip>Sustantivo para 'bosque'.</descrip>
      </termEntry>
      <termEntry id="term_mura">
        <langSet xml:lang="ja"><tig><term>村</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>pueblo</term></tig></langSet>
        <descrip>Un pueblo o aldea pequeña.</descrip>
        <note from="translator">También aldea.</note>
      </termEntry>
      <termEntry id="term_mushi">
        <langSet xml:lang="ja"><tig><term>虫</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>insecto</term></tig></langSet>
        <descrip>Término general para 'insecto' o 'bicho'.</descrip>
      </termEntry>
      <termEntry id="term_musume">
        <langSet xml:lang="ja"><tig><term>娘</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>hija</term></tig></langSet>
        <descrip>Sustantivo para 'hija'.</descrip>
      </termEntry>
      <termEntry id="term_na">
        <langSet xml:lang="ja"><tig><term>な</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>y,</term></tig></langSet>
        <descrip>Partícula final de oración que añade énfasis o busca confirmación.</descrip>
      </termEntry>
      <termEntry id="term_nanda">
        <langSet xml:lang="ja"><tig><term>なんだ</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>qué es</term></tig></langSet>
        <descrip>Forma corta de '何だ' (nan da), que significa '¿qué es?'.</descrip>
      </termEntry>
      <termEntry id="term_nandarou">
        <langSet xml:lang="ja"><tig><term>なんだろう</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>qué será</term></tig></langSet>
        <descrip>Expresión de duda o curiosidad, 'me pregunto qué será'.</descrip>
      </termEntry>
      <termEntry id="term_nandato">
        <langSet xml:lang="ja"><tig><term>なんだと</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>¿y qué si lo hago?</term></tig></langSet>
        <descrip>Expresión de incredulidad o desafío, '¿qué has dicho?'.</descrip>
      </termEntry>
      <termEntry id="term_nantonaku">
        <langSet xml:lang="ja"><tig><term>なんとなく</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>por alguna razón</term></tig></langSet>
        <descrip>Adverbio que indica que algo se hace sin una razón clara, 'de alguna manera'.</descrip>
      </termEntry>
      <termEntry id="term_naruhodo">
        <langSet xml:lang="ja"><tig><term>なるほど</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>sin duda</term></tig></langSet>
        <descrip>Expresión que denota comprensión o acuerdo, 'ya veo', 'entiendo'.</descrip>
      </termEntry>
      <termEntry id="term_nen">
        <langSet xml:lang="ja"><tig><term>年</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>año</term></tig></langSet>
        <descrip>Sustantivo para 'año'.</descrip>
      </termEntry>
      <termEntry id="term_ningen">
        <langSet xml:lang="ja"><tig><term>人間</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>humano</term></tig></langSet>
        <descrip>Sustantivo para 'ser humano' o 'persona'.</descrip>
        <note from="translator">También se traduce como "gente".</note>
      </termEntry>
      <termEntry id="term_nouryoku">
        <langSet xml:lang="ja"><tig><term>能力</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>habilidad</term></tig></langSet>
        <descrip>Sustantivo para 'habilidad', 'capacidad' o 'poder'.</descrip>
      </termEntry>
      <termEntry id="term_nouryoku_kaihou">
        <langSet xml:lang="ja"><tig><term>能力解放</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>habilidades liberadas</term></tig></langSet>
        <descrip>Liberación o desbloqueo de habilidades.</descrip>
      </termEntry>
      <termEntry id="term_nouryoku_mikaihou">
        <langSet xml:lang="ja"><tig><term>能力未解放</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>habilidades selladas</term></tig></langSet>
        <descrip>Habilidades aún no liberadas o selladas.</descrip>
      </termEntry>
      <termEntry id="term_o">
        <langSet xml:lang="ja"><tig><term>お</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>oh</term></tig></langSet>
        <descrip>Interjección de sorpresa o reconocimiento.</descrip>
      </termEntry>
      <termEntry id="term_okaasama">
        <langSet xml:lang="ja"><tig><term>お母さま</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>madre</term></tig></langSet>
        <descrip>Forma honorífica y muy formal para 'madre', usada a menudo por la nobleza.</descrip>
      </termEntry>
      <termEntry id="term_omake">
        <langSet xml:lang="ja"><tig><term>オマケ</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>bono</term></tig></langSet>
        <descrip>Un extra, un regalo o contenido adicional.</descrip>
      </termEntry>
      <termEntry id="term_onaji">
        <langSet xml:lang="ja"><tig><term>同じ</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>mismo</term></tig></langSet>
        <descrip>Adjetivo que significa 'igual' o 'mismo'.</descrip>
      </termEntry>
      <termEntry id="term_onna">
        <langSet xml:lang="ja"><tig><term>女</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>mujer</term></tig></langSet>
        <descrip>Sustantivo para 'mujer'.</descrip>
      </termEntry>
      <termEntry id="term_onnen">
        <langSet xml:lang="ja"><tig><term>怨念</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>rencor</term></tig></langSet>
        <descrip>Un profundo rencor, resentimiento o malevolencia, a menudo con connotaciones sobrenaturales.</descrip>
      </termEntry>
      <termEntry id="term_onryou">
        <langSet xml:lang="ja"><tig><term>怨霊</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>espíritu vengativo</term></tig></langSet>
        <descrip>Un fantasma o espíritu que busca venganza.</descrip>
        <note from="translator">También: espíritu rencoroso.</note>
      </termEntry>
      <termEntry id="term_ore">
        <langSet xml:lang="ja"><tig><term>俺</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>yo</term></tig></langSet>
        <descrip>Pronombre personal masculino e informal para 'yo'.</descrip>
      </termEntry>
      <termEntry id="term_osu">
        <langSet xml:lang="ja"><tig><term>雄</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>macho</term></tig></langSet>
        <descrip>Sexo masculino de un animal.</descrip>
      </termEntry>
      <termEntry id="term_otaku">
        <langSet xml:lang="ja"><tig><term>オタク</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>otaku</term></tig></langSet>
        <descrip>Persona con aficiones obsesivas, especialmente en anime, manga o videojuegos.</descrip>
      </termEntry>
      <termEntry id="term_otousama">
        <langSet xml:lang="ja"><tig><term>お父さま</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>padre</term></tig></langSet>
        <descrip>Forma honorífica y muy formal para 'padre', usada a menudo por la nobleza.</descrip>
      </termEntry>
      <termEntry id="term_otouto">
        <langSet xml:lang="ja"><tig><term>弟</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>hermano menor</term></tig></langSet>
        <descrip>Término para referirse al hermano menor de uno.</descrip>
      </termEntry>
      <termEntry id="term_otto">
        <langSet xml:lang="ja"><tig><term>おっと</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>ups</term></tig></langSet>
        <descrip>Interjección de sorpresa, similar a 'uy' o 'ups'.</descrip>
      </termEntry>
      <termEntry id="term_ou">
        <langSet xml:lang="ja"><tig><term>王</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>gobernante</term></tig></langSet>
        <descrip>Sustantivo para 'rey'. Puede ser rey o reina. La traducción es neutra.</descrip>
      </termEntry>
      <termEntry id="term_ouyo">
        <langSet xml:lang="ja"><tig><term>おうよ</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>¡seguro!</term></tig></langSet>
        <descrip>Forma enfática y masculina de afirmación, '¡claro que sí!'.</descrip>
      </termEntry>
      <termEntry id="term_ouzoku">
        <langSet xml:lang="ja"><tig><term>王族</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>realeza</term></tig></langSet>
        <descrip>La familia real o la realeza.</descrip>
      </termEntry>
      <termEntry id="term_oyako">
        <langSet xml:lang="ja"><tig><term>親子</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>madre e hija</term></tig></langSet>
        <descrip>Literalmente: padre/madre e hijo/a. El contexto define el género.</descrip>
      </termEntry>
      <termEntry id="term_raitonoberu">
        <langSet xml:lang="ja"><tig><term>ライトノベル</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>novela ligera</term></tig></langSet>
        <descrip>Del inglés 'light novel'. Novelas japonesas dirigidas a un público joven.</descrip>
      </termEntry>
      <termEntry id="term_retishia">
        <langSet xml:lang="ja"><tig><term>レティシア</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>leticia</term></tig></langSet>
        <descrip>Nombre propio femenino 'Leticia'.</descrip>
      </termEntry>
      <termEntry id="term_ri">
        <langSet xml:lang="ja"><tig><term>理</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>principio</term></tig></langSet>
        <descrip>Razón, principio o lógica, a menudo en un sentido cósmico o natural.</descrip>
      </termEntry>
      <termEntry id="term_ryoushitsu">
        <langSet xml:lang="ja"><tig><term>良質</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>buena</term></tig></langSet>
        <descrip>Calidad de un objeto: buena calidad.</descrip>
      </termEntry>
      <termEntry id="term_sama">
        <langSet xml:lang="ja"><tig><term>様</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>parece</term></tig></langSet>
        <descrip>Sufijo honorífico de máximo respeto. También puede significar 'apariencia' o 'estado'.</descrip>
      </termEntry>
      <termEntry id="term_sate">
        <langSet xml:lang="ja"><tig><term>さて</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>bien,</term></tig></langSet>
        <descrip>Interjección para cambiar de tema o iniciar una nueva acción, 'bueno', 'ahora bien'.</descrip>
      </termEntry>
      <termEntry id="term_seirei">
        <langSet xml:lang="ja"><tig><term>精霊</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>espíritu</term></tig></langSet>
        <descrip>Un espíritu de la naturaleza o elemental.</descrip>
      </termEntry>
      <termEntry id="term_sekai">
        <langSet xml:lang="ja"><tig><term>世界</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>mundo</term></tig></langSet>
        <descrip>Sustantivo para 'mundo'.</descrip>
      </termEntry>
      <termEntry id="term_shi">
        <langSet xml:lang="ja"><tig><term>史</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>historia</term></tig></langSet>
        <descrip>Sustantivo para 'historia' o 'crónica'.</descrip>
      </termEntry>
      <termEntry id="term_shinzou">
        <langSet xml:lang="ja"><tig><term>心臓</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>corazón</term></tig></langSet>
        <descrip>El órgano físico del corazón.</descrip>
      </termEntry>
      <termEntry id="term_shizuka">
        <langSet xml:lang="ja"><tig><term>静か</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>tranquilo</term></tig></langSet>
        <descrip>Adjetivo que significa 'silencioso', 'tranquilo' o 'calmado'.</descrip>
        <note from="translator">También: silencioso.</note>
      </termEntry>
      <termEntry id="term_shoujiki_na_tokoro">
        <langSet xml:lang="ja"><tig><term>正直な所</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>siendo honesto</term></tig></langSet>
        <descrip>Expresión para introducir una opinión sincera, 'honestamente hablando'.</descrip>
      </termEntry>
      <termEntry id="term_shoukan">
        <langSet xml:lang="ja"><tig><term>召喚</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>convocado</term></tig></langSet>
        <descrip>Sustantivo o verbo para 'invocación' o 'convocar', usualmente en un contexto mágico.</descrip>
      </termEntry>
      <termEntry id="term_shumi">
        <langSet xml:lang="ja"><tig><term>趣味</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>afición</term></tig></langSet>
        <descrip>Sustantivo para 'hobby' o 'pasatiempo'.</descrip>
      </termEntry>
      <termEntry id="term_shuu">
        <langSet xml:lang="ja"><tig><term>集</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>colección</term></tig></langSet>
        <descrip>Sustantivo para 'colección' o 'recopilación'.</descrip>
      </termEntry>
      <termEntry id="term_soudana">
        <langSet xml:lang="ja"><tig><term>そうだな</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>así es</term></tig></langSet>
        <descrip>Expresión de acuerdo, 'es cierto', 'así es'.</descrip>
      </termEntry>
      <termEntry id="term_souieba">
        <langSet xml:lang="ja"><tig><term>そういえば</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>por cierto,</term></tig></langSet>
        <descrip>Expresión para introducir un tema recordado de repente, 'ahora que lo mencionas'.</descrip>
      </termEntry>
      <termEntry id="term_souiya">
        <langSet xml:lang="ja"><tig><term>そういや</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>ahora que lo pienso,</term></tig></langSet>
        <descrip>Variante informal de 'souieba'.</descrip>
      </termEntry>
      <termEntry s_id="term_soredewa">
        <langSet xml:lang="ja"><tig><term>それでは</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>hasta entonces</term></tig></langSet>
        <descrip>Expresión formal para concluir o pasar a la siguiente acción, 'entonces', 'en ese caso'.</descrip>
      </termEntry>
      <termEntry id="term_soredeite">
        <langSet xml:lang="ja"><tig><term>それでいて</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>aun así</term></tig></langSet>
        <descrip>Conjunción que significa 'y sin embargo', 'a pesar de eso'.</descrip>
      </termEntry>
      <termEntry id="term_sukou">
        <langSet xml:lang="ja"><tig><term>救う</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>salvar</term></tig></langSet>
        <descrip>Verbo para 'salvar' o 'rescatar'.</descrip>
      </termEntry>
      <termEntry id="term_suraimu">
        <langSet xml:lang="ja"><tig><term>スライム</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>limo</term></tig></langSet>
        <descrip>Del inglés 'slime'. Monstruo gelatinoso de fantasía.</descrip>
      </termEntry>
      <termEntry id="term_suruto">
        <langSet xml:lang="ja"><tig><term>すると</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>luego</term></tig></langSet>
        <descrip>Conjunción que indica una consecuencia o un suceso posterior, 'entonces', 'y entonces'.</descrip>
      </termEntry>
      <termEntry id="term_sumi">
        <langSet xml:lang="ja"><tig><term>隅</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>esquina</term></tig></langSet>
        <descrip>Sustantivo para 'esquina' o 'rincón'.</descrip>
      </termEntry>
      <termEntry id="term_tabi">
        <langSet xml:lang="ja"><tig><term>旅</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>viaje</term></tig></langSet>
        <descrip>Sustantivo para 'viaje' o 'travesía'.</descrip>
      </termEntry>
      <termEntry id="term_tashikani">
        <langSet xml:lang="ja"><tig><term>確かに</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>ciertamente</term></tig></langSet>
        <descrip>Adverbio que significa 'ciertamente', 'sin duda'.</descrip>
      </termEntry>
      <termEntry id="term_te">
        <langSet xml:lang="ja"><tig><term>手</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>mano</term></tig></langSet>
        <descrip>Sustantivo para 'mano'.</descrip>
      </termEntry>
      <termEntry id="term_tobira">
        <langSet xml:lang="ja"><tig><term>扉</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>puerta</term></tig></langSet>
        <descrip>Sustantivo para 'puerta', a menudo una grande o importante.</descrip>
      </termEntry>
      <termEntry id="term_tokei">
        <langSet xml:lang="ja"><tig><term>時計</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>reloj</term></tig></langSet>
        <descrip>Sustantivo para 'reloj'.</descrip>
      </termEntry>
      <termEntry id="term_tokage">
        <langSet xml:lang="ja"><tig><term>蜥蜴</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>lagartija</term></tig></langSet>
        <descrip>Sustantivo para 'lagarto' o 'lagartija'.</descrip>
      </termEntry>
      <termEntry id="term_tokusei">
        <langSet xml:lang="ja"><tig><term>特性</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>característica</term></tig></langSet>
        <descrip>Una característica especial, rasgo o habilidad inherente.</descrip>
        <note from="translator">A veces traducido como "habilidad".</note>
      </termEntry>
      <termEntry id="term_totsuzen_hen_i">
        <langSet xml:lang="ja"><tig><term>突然変異</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>mutación</term></tig></langSet>
        <descrip>Una mutación biológica repentina.</descrip>
      </termEntry>
      <termEntry id="term_tsumorika">
        <langSet xml:lang="ja"><tig><term>つもりか</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>intentas</term></tig></langSet>
        <descrip>Forma interrogativa que pregunta sobre la intención de alguien, '¿piensas...?', '¿tienes la intención de...?'.</descrip>
      </termEntry>
      <termEntry id="term_ttaku">
        <langSet xml:lang="ja"><tig><term>ったく</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>caray</term></tig></langSet>
        <descrip>Abreviación de 'mattaku'. Expresión de exasperación, 'cielos', 'caray'.</descrip>
      </termEntry>
      <termEntry id="term_wakatta">
        <langSet xml:lang="ja"><tig><term>分かった</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>comprendo</term></tig></langSet>
        <descrip>Forma pasada de 'wakaru' (entender). Significa 'entendí' o 'de acuerdo'.</descrip>
      </termEntry>
      <termEntry id="term_wakatteruyo">
        <langSet xml:lang="ja"><tig><term>分かってるよ</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>lo sé</term></tig></langSet>
        <descrip>Forma enfática de decir 'lo sé' o 'ya lo entiendo'.</descrip>
      </termEntry>
      <termEntry id="term_ware">
        <langSet xml:lang="ja"><tig><term>我</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>yo</term></tig></langSet>
        <descrip>Pronombre personal arcaico o formal para 'yo', usado a menudo por deidades o reyes.</descrip>
      </termEntry>
      <termEntry id="term_yami">
        <langSet xml:lang="ja"><tig><term>闇</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>oscuridad</term></tig></langSet>
        <descrip>Sustantivo para 'oscuridad'.</descrip>
      </termEntry>
      <termEntry id="term_yappari">
        <langSet xml:lang="ja"><tig><term>やっぱり</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>después de todo</term></tig></langSet>
        <descrip>Expresión que significa 'tal como pensaba', 'después de todo'.</descrip>
      </termEntry>
      <termEntry id="term_yoroi">
        <langSet xml:lang="ja"><tig><term>鎧</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>armadura</term></tig></langSet>
        <descrip>Sustantivo para 'armadura'.</descrip>
      </termEntry>
      <termEntry id="term_yubi">
        <langSet xml:lang="ja"><tig><term>指</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>dedo</term></tig></langSet>
        <descrip>Sustantivo para 'dedo'.</descrip>
      </termEntry>
      <termEntry id="term_yugami">
        <langSet xml:lang="ja"><tig><term>歪み</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>deformación</term></tig></langSet>
        <descrip>Una distorsión, deformación o perversión.</descrip>
      </termEntry>
      <termEntry id="term_yume">
        <langSet xml:lang="ja"><tig><term>夢</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>sueño</term></tig></langSet>
        <descrip>Sustantivo para 'sueño'.</descrip>
      </termEntry>
      <termEntry id="term_yuusha">
        <langSet xml:lang="ja"><tig><term>勇者</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>héroe</term></tig></langSet>
        <descrip>El 'héroe' o 'valiente', protagonista principal en historias de fantasía.</descrip>
      </termEntry>
      <termEntry id="term_zako">
        <langSet xml:lang="ja"><tig><term>雑魚</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>esbirro</term></tig></langSet>
        <descrip>Enemigo débil, 'minion' o 'morralla'.</descrip>
      </termEntry>
      <termEntry id="term_zasshi">
        <langSet xml:lang="ja"><tig><term>雑誌</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>revista</term></tig></langSet>
        <descrip>Sustantivo para 'revista' o 'magacín'.</descrip>
      </termEntry>
      <termEntry id="onomatopoeia_fuwaa">
        <langSet xml:lang="ja"><tig><term>ふわぁ</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>bostezo</term></tig></langSet>
        <descrip>Onomatopeya para un bostezo.</descrip>
        <note from="translator">Alternativa: *bostezo*.</note>
      </termEntry>
      <termEntry id="onomatopoeia_gashi">
        <langSet xml:lang="ja"><tig><term>ガシ</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>clink</term></tig></langSet>
        <descrip>Onomatopeya de un agarre fuerte o un sonido metálico.</descrip>
        <note from="translator">Sonido de monedas o algo metálico. Alternativa: *clink*.</note>
      </termEntry>
      <termEntry id="onomatopoeia_gunu">
        <langSet xml:lang="ja"><tig><term>ぐぬ</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>ujum…</term></tig></langSet>
        <descrip>Onomatopeya que expresa molestia o frustración contenida.</descrip>
      </termEntry>
      <termEntry id="onomatopoeia_muu">
        <langSet xml:lang="ja"><tig><term>むぅ</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>hmuh</term></tig></langSet>
        <descrip>Onomatopeya para expresar descontento o estar pensativo, inflando las mejillas.</descrip>
      </termEntry>
      <termEntry id="onomatopoeia_n">
        <langSet xml:lang="ja"><tig><term>ん</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>¿uh?</term></tig></langSet>
        <descrip>Sonido de duda, sorpresa o al notar algo.</descrip>
      </termEntry>
      <termEntry id="onomatopoeia_pera">
        <langSet xml:lang="ja"><tig><term>ペラ</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>flip</term></tig></langSet>
        <descrip>Onomatopeya del sonido de pasar una página o algo fino y plano.</descrip>
        <note from="translator">Sonido de pasar una página. Alternativa: *flip*.</note>
      </termEntry>
      <termEntry id="onomatopoeia_pikoon">
        <langSet xml:lang="ja"><tig><term>ピコーン</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>tintineo</term></tig></langSet>
        <descrip>Onomatopeya de un sonido de alerta o de tener una idea brillante.</descrip>
        <note from="translator">Sonido al tener una idea. Alternativa: *tintineo*.</note>
      </termEntry>
      <termEntry id="onomatopoeia_zorozoro">
        <langSet xml:lang="ja"><tig><term>ゾロゾロ</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>en masa</term></tig></langSet>
        <descrip>Onomatopeya que describe a un gran grupo de personas o cosas moviéndose juntas.</descrip>
      </termEntry>
      <termEntry id="onomatopoeia_zuzu">
        <langSet xml:lang="ja"><tig><term>ズズ</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>slup</term></tig></langSet>
        <descrip>Onomatopeya para el sonido de algo pegajoso moviéndose (limo) o de un sorbo.</descrip>
        <note from="translator">Alternativa: *slup*.</note>
      </termEntry>
      <termEntry id="particle_de">
        <descrip>Partícula que indica lugar de acción, medio o causa.</descrip>
        <langSet xml:lang="ja"><tig><term>で</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>en / con / y</term></tig></langSet>
      </termEntry>
      <termEntry id="particle_e">
        <descrip>Partícula que indica dirección.</descrip>
        <langSet xml:lang="ja"><tig><term>へ</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>hacia / a</term></tig></langSet>
      </termEntry>
      <termEntry id="particle_ga">
        <descrip>Partícula que marca el sujeto de una oración.</descrip>
        <langSet xml:lang="ja"><tig><term>が</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>(marcador de sujeto)</term></tig></langSet>
      </termEntry>
      <termEntry id="particle_ka">
        <descrip>Partícula que indica una pregunta o una opción.</descrip>
        <langSet xml:lang="ja"><tig><term>か</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>?</term></tig></langSet>
        <note from="translator">Al final de una oración la convierte en pregunta.</note>
      </termEntry>
      <termEntry id="particle_kara">
        <descrip>Partícula que indica el punto de partida (desde).</descrip>
        <langSet xml:lang="ja"><tig><term>から</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>desde</term></tig></langSet>
      </termEntry>
      <termEntry id="particle_mo">
        <descrip>Partícula que significa "también" o "además".</descrip>
        <langSet xml:lang="ja"><tig><term>も</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>también</term></tig></langSet>
      </termEntry>
      <termEntry id="particle_ni">
        <descrip>Partícula que indica ubicación, tiempo o dirección.</descrip>
        <langSet xml:lang="ja"><tig><term>に</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>en / a / hacia</term></tig></langSet>
      </termEntry>
      <termEntry id="particle_no">
        <descrip>Partícula posesiva.</descrip>
        <langSet xml:lang="ja"><tig><term>の</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>de</term></tig></langSet>
      </termEntry>
      <termEntry id="particle_to">
        <descrip>Partícula que significa "y" para enumerar sustantivos.</descrip>
        <langSet xml:lang="ja"><tig><term>と</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>y</term></tig></langSet>
      </termEntry>
      <termEntry id="particle_wa">
        <descrip>Partícula que marca el tema principal de la oración.</descrip>
        <langSet xml:lang="ja"><tig><term>は</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>(marcador de tema)</term></tig></langSet>
      </termEntry>
      <termEntry id="particle_wo">
        <descrip>Partícula que marca el objeto directo de un verbo.</descrip>
        <langSet xml:lang="ja"><tig><term>を</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>(marcador de objeto directo)</term></tig></langSet>
      </termEntry>
      <termEntry id="particle_ya">
        <descrip>Partícula que significa "y", para enumerar ejemplos no exhaustivos.</descrip>
        <langSet xml:lang="ja"><tig><term>や</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>y / etc.</term></tig></langSet>
      </termEntry>
      <termEntry id="quality_warui">
        <descrip>Calidad de un objeto: mala.</descrip>
        <langSet xml:lang="ja"><tig><term>悪い</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>mala</term></tig></langSet>
      </termEntry>
      <termEntry id="quality_yayawarui">
        <descrip>Calidad de un objeto: aceptable (lado malo).</descrip>
        <langSet xml:lang="ja"><tig><term>やや悪い</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>aceptable</term></tig></langSet>
        <note from="translator">Literalmente "un poco malo".</note>
      </termEntry>
      <termEntry id="quality_yayayoi">
        <descrip>Calidad de un objeto: aceptable (lado bueno).</descrip>
        <langSet xml:lang="ja"><tig><term>やや良い</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>aceptable</term></tig></langSet>
        <note from="translator">Literalmente "un poco bueno".</note>
      </termEntry>
      <termEntry id="verb_hanasu_inf">
        <descrip>Verbo en forma infinitiva para 'hablar'.</descrip>
        <langSet xml:lang="ja"><tig><term>話す</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>hablar</term></tig></langSet>
      </termEntry>
      <termEntry id="verb_ikiru_inf">
        <descrip>Verbo en forma infinitiva para 'vivir'.</descrip>
        <langSet xml:lang="ja"><tig><term>生きる</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>vivir</term></tig></langSet>
      </termEntry>
      <termEntry id="verb_iku_inf">
        <descrip>Verbo en forma infinitiva para 'ir'.</descrip>
        <langSet xml:lang="ja"><tig><term>行く</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>ir</term></tig></langSet>
      </termEntry>
      <termEntry id="verb_iu_inf">
        <descrip>Verbo en forma infinitiva para 'decir'.</descrip>
        <langSet xml:lang="ja"><tig><term>言う</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>decir</term></tig></langSet>
      </termEntry>
      <termEntry id="verb_kuru_inf">
        <descrip>Verbo en forma infinitiva para 'venir'.</descrip>
        <langSet xml:lang="ja"><tig><term>来る</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>venir</term></tig></langSet>
      </termEntry>
      <termEntry id="verb_miru_inf">
        <descrip>Verbo en forma infinitiva para 'ver' o 'mirar'.</descrip>
        <langSet xml:lang="ja"><tig><term>見る</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>ver</term></tig></langSet>
      </termEntry>
      <termEntry id="verb_okiru_inf">
        <descrip>Verbo en forma infinitiva para 'despertar' o 'levantarse'.</descrip>
        <langSet xml:lang="ja"><tig><term>起きる</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>despertar</term></tig></langSet>
      </termEntry>
      <termEntry id="verb_omou_inf">
        <descrip>Verbo en forma infinitiva para 'pensar' o 'creer'.</descrip>
        <langSet xml:lang="ja"><tig><term>思う</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>pensar</term></tig></langSet>
      </termEntry>
      <termEntry id="verb_taberu_inf">
        <descrip>Verbo en forma infinitiva para 'comer'.</descrip>
        <langSet xml:lang="ja"><tig><term>食べる</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>comer</term></tig></langSet>
      </termEntry>
      <termEntry id="verb_taosu_inf">
        <descrip>Verbo en forma infinitiva para 'derrotar'.</descrip>
        <langSet xml:lang="ja"><tig><term>倒す</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>derrotar</term></tig></langSet>
      </termEntry>
      <termEntry id="verb_umareru_inf">
        <descrip>Verbo en forma infinitiva para 'nacer'.</descrip>
        <langSet xml:lang="ja"><tig><term>生まれる</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>nacer</term></tig></langSet>
      </termEntry>
      <termEntry id="verb_yobu_inf">
        <descrip>Verbo en forma infinitiva para 'llamar'.</descrip>
        <langSet xml:lang="ja"><tig><term>呼ぶ</term></tig></langSet>
        <langSet xml:lang="es"><tig><term>llamar</term></tig></langSet>
      </termEntry>
    </body>
  </text>
</martif>
